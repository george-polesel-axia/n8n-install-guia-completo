# =============================================================================
# n8n em Ubuntu 24.04 - arquivo público de exemplo
# Copie para .env e substitua TODOS os valores marcados com TROQUE_...
# Nunca publique o arquivo .env real.
# =============================================================================

# Versões verificadas em 04/09/2026.
# Atualize deliberadamente e somente após fazer backup e ler as release notes.
N8N_VERSION=2.37.9
CADDY_VERSION=2.11.4-alpine
POSTGRES_VERSION=18

# Domínio sem https:// e sem barra no final.
N8N_DOMAIN=n8n.seudominio.com.br
LETSENCRYPT_EMAIL=voce@seudominio.com.br
GENERIC_TIMEZONE=America/Sao_Paulo

# PostgreSQL: use nomes simples, apenas com letras, números e underscore.
POSTGRES_DB=n8n
POSTGRES_USER=n8n_admin
POSTGRES_PASSWORD=TROQUE_POR_64_CARACTERES_HEXADECIMAIS
POSTGRES_NON_ROOT_USER=n8n_app
POSTGRES_NON_ROOT_PASSWORD=TROQUE_POR_OUTROS_64_CARACTERES_HEXADECIMAIS

# Chave que criptografa as credenciais salvas no n8n.
# Depois da primeira inicialização, NÃO altere esta chave.
N8N_ENCRYPTION_KEY=TROQUE_POR_OUTROS_64_CARACTERES_HEXADECIMAIS

# Token privado usado na comunicação entre n8n e task runner.
RUNNERS_AUTH_TOKEN=TROQUE_POR_OUTROS_64_CARACTERES_HEXADECIMAIS

# Retenção do histórico de execuções, em horas. 336 horas = 14 dias.
EXECUTIONS_DATA_MAX_AGE=336
